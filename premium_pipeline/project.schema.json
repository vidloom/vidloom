{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vidloom Premium Project",
  "type": "object",
  "required": ["version", "title", "narration", "edit", "audio"],
  "oneOf": [
    {"required": ["source"]},
    {"required": ["sources"]}
  ],
  "properties": {
    "version": {"const": 1},
    "title": {"type": "string", "minLength": 3},
    "source": {"type": "string"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "tail_seconds": {"type": "number", "minimum": 0.15, "maximum": 1.0},
    "narration": {
      "type": "object",
      "required": ["engine", "beats"],
      "properties": {
        "engine": {"enum": ["kokoro", "edge"]},
        "beats": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "required": ["text", "captions"],
            "properties": {
              "text": {"type": "string"},
              "captions": {"type": "array", "minItems": 1, "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "edit": {
      "type": "object",
      "required": ["shots"],
      "properties": {
        "active_crop": {"type": "string", "pattern": "^[0-9]+:[0-9]+:[0-9]+:[0-9]+$"},
        "shots": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": "object",
            "required": ["start", "weight"],
            "properties": {
              "start": {"type": "number", "minimum": 0},
              "weight": {"type": "number", "exclusiveMinimum": 0},
              "source_index": {"type": "integer", "minimum": 0},
              "speed": {"type": "number", "exclusiveMinimum": 0, "maximum": 4},
              "crop_start": {"type": "number", "minimum": 0, "maximum": 1},
              "crop_end": {"type": "number", "minimum": 0, "maximum": 1}
            }
          }
        }
      }
    },
    "audio": {"type": "object", "required": ["production_volume"]}
  }
}
